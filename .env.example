# Optional cloud sync (Neon). Copy this file to .env.local and fill it in. Never commit .env.local.
# Without these the app works exactly as before, storing progress only in the browser.

# Neon connection string (Neon console > Connect). The pooled one (host contains "-pooler") is best for the app.
DATABASE_URL=

# Optional: the direct (non-pooled) connection string. `npm run db:migrate` prefers it for schema changes.
DATABASE_URL_UNPOOLED=

# Shared secret every device pastes into Settings > Cloud sync. At least 32 characters: run `npm run sync:token`.
SYNC_TOKEN=

# Development only: keep synced data in the server's memory instead of a database (lost on restart).
# SYNC_STORE=memory
